epage\"}},{\"name\":null,\"id\":\"Common.VerticalSpacing\",\"placement\":\"children\",\"displayOrder\":null,\"data\":{\"height\":\"40\",\"mobileHeight\":\"25\",\"tabHeight\":\"25\",\"notebookHeight\":\"25\"}},{\"name\":null,\"id\":\"Common.StudyResources\",\"placement\":\"children\",\"displayOrder\":null,\"data\":{\"sectionTitle\":\"Study Resources\",\"sectionSubTitle\":\"A diverse array of learning materials to enhance your educational journey.\",\"sectionProps\":[{\"title\":\"Reference Books\",\"description\":\"Our experts have created thorough study materials that break down complicated concepts into easily understandable content\",\"redirectionUrl\":\"https://store.pw.live/school-books\",\"dwebImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/cec394b1-2ad1-4b79-8664-34669a0d1b6c.webp\",\"mwebImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/549d55ef-d3df-4aae-b3a0-c8982f5c4c91.webp\"},{\"title\":\"NCERT Solutions\",\"description\":\"Unlock academic excellence with Physics Wallah’s NCERT Solutions which provides you step-by-step solutions\",\"redirectionUrl\":\"https://www.pw.live/concepts-ncert-solutions\",\"dwebImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/19003e06-70cd-4dd7-9703-2cb794f67331.webp\",\"mwebImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/74afaf7e-7ae8-4e70-bd74-efa184d359d8.webp\"},{\"title\":\"Notes\",\"description\":\"Use Physics Wallah’s detailed study materials that simplify complex ideas into easily understandable language\",\"redirectionUrl\":\"https://www.pw.live/topics-biology-class-10\",\"dwebImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/eb782327-67e0-49b4-91be-0114d93ae70f.webp\",\"mwebImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/252680a9-b822-4397-9e59-ccd00c867ba9.webp\"}]}},{\"name\":null,\"id\":\"Common.PhoneIcon\",\"placement\":\"children\",\"displayOrder\":null,\"data\":{\"page_source\":\"Homepage\",\"title\":\"Talk to a counsellor\",\"description\":\"Have doubts? Our support team will be happy to assist you!\",\"popUpCloseImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/83187fa1-2dcb-4db5-8d31-978edc63c211.webp\",\"popUpCtaText\":\"7290070560\",\"popUpOpenImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/20feabc1-1a43-4967-9ee2-e6be4f71268a.webp\",\"popUpInsideImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/4b06191d-2e34-4ed5-a2e8-e1cd3bb0a6e2.webp\",\"popUpCtaImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/2e3ff683-af2d-422d-b466-888c4ebc8c56.webp\",\"isIoi\":false,\"isGurukulam\":false,\"isNios\":false}},{\"name\":null,\"id\":\"Common.Testimonial\",\"placement\":\"children\",\"displayOrder\":null,\"data\":{\"title\":\"Students ❤️ Physics Wallah\",\"subTitle\":\"Hear from our students\",\"withMainCard\":true,\"cardItems\":[{\"description\":\"My name is Tathagat Awatar. I secured All India Rank 1 by scoring full score in NEET UG 2024. I started my preparation with Physics Wallah in 12th grade by joining the Lakshya NEET batch, then I took 2 drop by joining Yakeen NEET batch and I completed my full preparation from online PW batch. PW teachers and their guidance helps me to acheive AIR1 and motivated me during my drop year....\",\"variant\":true,\"authorName\":\"Multiple Rankers\",\"videoImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/dfb2edd9-4838-4cc8-adab-541dbcb97b38.webp\",\"videoYoutubeUrl\":\"https://www.youtube.com/embed/xrEUbWOLZ34?si=G5vA9A0RsDYNhocq\u0026autoplay=1\",\"potraitMode\":false,\"rank\":\"AIR 1\",\"subject\":\"NEET\",\"type\":\"primary\"},{\"description\":\"I used to regularly follow the youtube videos, prelims booster videos and specially editorial discussion from where I made important pointers. I also watched some history videos like Buddhism, Jainism as the topics were explained very clearly… all these were very helpful during my preparation…\",\"variant\":false,\"authorName\":\"Anmol Rathore\",\"authorImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/f701dd38-826d-4328-836e-8e1061c5d281.jpg\",\"potraitMode\":false,\"rank\":\"UPSC CSE 2023 AIR 7\",\"subject\":\"UPSE\",\"type\":\"primary\"},{\"description\":\"I am Raja Majhi, and I am thrilled to share that I have secured All India Rank 1 (AIR 1) in the GATE 2024 examination in ECE. From the very beginning, Physics Wallah stood out for its structured and comprehensive curriculum. The faculty members, with their in-depth knowledge and teaching expertise, ensured that every concept was crystal clear. GATE Wallah not only provided academic support but also fostered a positive and encouraging learning environment. The online resources, interactive sessions, and community forums allowed me to connect with fellow aspirants and learn collaboratively.\",\"variant\":false,\"authorName\":\"Raja Majhi\",\"authorImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/5613a51e-e9ac-4e90-a78e-81dba01b1940.png\",\"potraitMode\":false,\"rank\":\"GATE 2024 AIR 1\",\"subject\":\"GATE\",\"type\":\"primary\"},{\"description\":\"PW helped me in establishing the basics of every subject through which I was able to progress quickly and was also able to increase my speed and also maintaining accuracy.\",\"variant\":false,\"authorName\":\"Amit Kumar Mandal\",\"authorImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/0274f09e-6be0-40cf-bbfa-f74fb07eb430.png\",\"potraitMode\":false,\"rank\":\"IBPS Topper\",\"subject\":\"Banking\",\"type\":\"primary\"},{\"description\":\"My name is Sushant Padha. I secured an AIR 52 in JEE Advanced 2024. I started my preparation with Physics Wallah in 11th grade by joining the Arjuna batch. In 12th grade, I joined the Lakshya batch and completed my entire preparation with Physics Wallah. PW teachers and their guidance played a very important role in achieving my goal. Once I started my preparation, I never looked back.\",\"variant\":false,\"authorName\":\"Sushant Padha\",\"authorImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/e588ef54-2d7f-457e-aa73-5e96a7468efb.png\",\"potraitMode\":false,\"rank\":\"JEE Advanced 2024 AIR 52\",\"subject\":\"IIT JEE\",\"type\":\"primary\"},{\"description\":\"My name is Karan Garg, and I secured 710 marks in the NEET UG 2024 exam, achieving an All India Rank of 429. I am thrilled to have had the opportunity to study for my NEET journey with Physics Wallah, as their teachers' content and guidance were superb. Mohit Dhadeech sir was a huge inspiration for me, motivating me to give my best in NEET through his guidance during lectures. Thank you to the entire Physics Wallah team for making my NEET journey easier.\",\"variant\":false,\"authorName\":\"Karan Garg\",\"authorImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/231a6f80-9fe5-49ba-b520-db9d310cb185.png\",\"potraitMode\":false,\"rank\":\"AIR 429\",\"subject\":\"NEET\",\"type\":\"primary\"},{\"description\":\"Thanks to PW! PW faculties teaches from basic and they are very supportive because of which I am able to secure AIR 99 in JEE Adavnced 2024. I studied from Varun JEE Adanced 2024 Batch.\",\"variant\":false,\"authorName\":\"Tanay\",\"authorImage\":\"https://static.pw.live/5eb393ee95fab7468a79d189/GLOBAL_CMS/a1fe3c64-edb7-484b-9f1e-ca488ee5a907.png\",\"potraitMode\":false,\"rank\":\"JEE Advanced 2024 AIR 99\",\"subject\":\"IIT JEE\",\"type\":\"primary\"}],\"showCarouselDots\":false,\"animation\":true,\"careerKaptain\":false}},{\"name\":null,\"id\":\"Common.YTSection\",\"placement\":\"children\",\"displayOrder\":null,\"data\":{\"title\":\"Join The PW Family, Today!\",\"subTitle\":\"Explore our 130+ YouTube Channels and subscribe to get access to quality education for free.\",\"cards\":[{\"title\":\"Physics Wallah\",\"subscribers\":\"11.5M\",\"variant\":\"platinium\"},{\"title\":\"Competition Wallah\",\"subscribers\":\"2.71M\",\"variant\":\"gold\"},{\"title\":\"JEE Wallah\",\"subscribers\":\"1.69M\",\"variant\":\"gold\"},{\"title\":\"NCERT Wallah\",\"subscribers\":\"1.35M\",\"variant\":\"gold\"},{\"title\":\"Physics Wallah Foundation\",\"subscribers\":\"3.48M\",\"variant\":\"gold\"}],\"cta\":{\"text\":\"Get Started\",\"variant\":\"primary\"}}},{\"name\":null,\"id\":\"Common.VerticalSpacing\",\"placement\":\"children\",\"displayOrder\":null,\"data\":{\"height\":20,\"mobileHeight\":20,\"tabHeight\":20,\"notebookHeight\":20}}],\"breadcrumbs\":[{\"name\":\"Home\",\"slug\":\"/\"},{\"name\":\"Home\",\"slug\":\"/\"}],\"seoSchema\":[],\"isNewsPage\":false,\"id\":\"69fd885eee4c747af08fd840\",\"layout\":\"$196\"},\"category\":{\"name\":\"pw homepage\",\"parentId\":null,\"cohortIds\":[],\"groupIds\":[\"691c2d1910f119cadcfd9c86\",\"6942d85dcb88ae724119bbeb\",\"69711cc315b48f1d949da708\",\"697255777b13750a995789fc\"],\"notVisibleInRoute\":false,\"displayName\":\"pw homepage\",\"id\":\"67a1f60608ee40649d5b15e7\"},\"id\":\"69fd885eee4c747af08fd836\",\"groupId\":null,\"createdBy\":{\"firstName\":\"aniket\",\"lastName\":\"teacher\",\"id\":\"641406764733d60018796ce1\"},\"searchParams\":{},\"pathname\":\"/\",\"cameFromApp\":false,\"cameFromHome\":true,\"isPWPage\":true},\"pageMetaData\":\"$2cd\",\"domainConfig\":{\"thirdPartyTags\":{\"gtmId\":\"GTM-TGJHCW7D\",\"pixelId\":\"528112298285279\",\"clarityId\":\"pydpgf4cyi\",\"firebaseConfig\":{\"apiKey\":\"AIzaSyApsQyaMPr0NBBXi9OR7x7y0Kbc5qfLNc0\",\"authDomain\":\"physics-wallah-65ada.firebaseapp.com\",\"databaseURL\":\"https://physics-wallah-65ada.firebaseio.com\",\"projectId\":\"physics-wallah-65ada\",\"storageBucket\":\"physics-wallah-65ada.appspot.com\",\"messagingSenderId\":\"252537344732\",\"appId\":\"1:252537344732:web:59fbcdbca9e85979c4da19\",\"measurementId\":\"G-9RN512817V\"}},\"organizationSchema\":{\"@context\":\"https://schema.org/\",\"@type\":\"Organization\",\"name\":\"Physics Wallah\",\"url\":\"https://www.pw.live/\",\"logo\":\"https://static.pw.live/ima